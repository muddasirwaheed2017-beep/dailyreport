# ── Anthropic ────────────────────────────────────────────────
# Also satisfied by ANTHROPIC_AUTH_TOKEN or an `ant auth login` profile.
ANTHROPIC_API_KEY=

# Models (defaults shown)
# WA_MODEL_BRIEF=claude-sonnet-4-6
# WA_MODEL_TRIAGE=claude-haiku-4-5

# ── Push transport ───────────────────────────────────────────
# telegram | pushover | both | none
WA_PUSH_PROVIDER=telegram

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# PUSHOVER_TOKEN=
# PUSHOVER_USER=

# ── Tuning (defaults shown) ───────────────────────────────────
# WA_FLUSH_QUIET_MS=90000
# WA_FLUSH_MAX=10
# WA_CONTEXT_LIMIT=30
# WA_TZ_OFFSET=+05:00
# WA_LOG_LEVEL=warn

# ── Checkpoint seed overrides ─────────────────────────────────
# Only needed if the dated seeds in src/config.js are not precise enough.
# WA_SEED_CNC_SHIPMENTS=2026-08-21T17:40:00+05:00
# WA_SEED_CNC_IMPORT_MATTERS=2026-08-23T19:15:00+05:00
